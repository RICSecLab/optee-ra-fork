From 79202d0cef23423b0153b00a56dc01d3bd726155 Mon Sep 17 00:00:00 2001
From: Yuichi Sugiyama <yuichis@ricsec.co.jp>
Date: Mon, 12 Oct 2026 12:33:32 +0000
Subject: [PATCH] pta: veraison_attestation: derive the client-id from
 the calling TA

The PSA client-id, which names the caller the evidence is about, was
the constant 1. The PTA already requires a user TA as caller and knows
its session, so derive the client-id from the calling TA's UUID: the
SHA-256 of the UUID in RFC 4122 octet form, reduced to 1..2^31-1, the
range the PSA token reserves for callers in the secure world. No
parameter is added.

Upstream-Status: Submitted [https://github.com/OP-TEE/optee_os/pull/8109]
Signed-off-by: Yuichi Sugiyama <yuichis@ricsec.co.jp>
---
 .../veraison_attestation.c                    | 47 ++++++++++++++++++-
 1 file changed, 45 insertions(+), 2 deletions(-)

diff --git a/core/pta/veraison_attestation/veraison_attestation.c b/core/pta/veraison_attestation/veraison_attestation.c
index 6e5901d..ea66c25 100644
--- a/core/pta/veraison_attestation/veraison_attestation.c
+++ b/core/pta/veraison_attestation/veraison_attestation.c
@@ -12,9 +12,11 @@
 #include <kernel/user_ta.h>
 #include <mempool.h>
 #include <pta_veraison_attestation.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
 #include <ta_pub_key.h>
+#include <tee/uuid.h>
 #include <utee_defines.h>
 
 #include "cbor.h"
@@ -30,7 +32,6 @@
 #define TEE_SHA256_HASH_SIZE 32
 
 #define EAT_PROFILE "http://arm.com/psa/2.0.0"
-#define CLIENT_ID 1
 #define LIFECYCLE 12288
 #define MEASURMENT_TYPE "PRoT"
 
@@ -111,6 +112,44 @@ static TEE_Result get_ta_signer_id(const TEE_UUID *uuid,
 	return get_ta_root_key_id(signer_id);
 }
 
+/*
+ * The PSA client-id names the caller the evidence is about. Derive it from
+ * the UUID of the calling TA: the SHA-256 of the UUID in its RFC 4122 octet
+ * form, reduced to 1..INT32_MAX, the value range the PSA token reserves for
+ * callers in the secure world.
+ */
+static TEE_Result get_client_id(const TEE_UUID *uuid, int *client_id)
+{
+	uint8_t hash[TEE_SHA256_HASH_SIZE] = { };
+	uint8_t octets[sizeof(TEE_UUID)] = { };
+	TEE_Result res = TEE_SUCCESS;
+	void *ctx = NULL;
+	uint32_t v = 0;
+
+	tee_uuid_to_octets(octets, uuid);
+
+	res = crypto_hash_alloc_ctx(&ctx, TEE_ALG_SHA256);
+	if (res != TEE_SUCCESS)
+		return res;
+	res = crypto_hash_init(ctx);
+	if (res != TEE_SUCCESS)
+		goto out;
+	res = crypto_hash_update(ctx, octets, sizeof(octets));
+	if (res != TEE_SUCCESS)
+		goto out;
+	res = crypto_hash_final(ctx, hash, sizeof(hash));
+	if (res != TEE_SUCCESS)
+		goto out;
+
+	v = ((uint32_t)hash[28] << 24) | ((uint32_t)hash[29] << 16) |
+	    ((uint32_t)hash[30] << 8) | hash[31];
+	*client_id = 1 + v % INT32_MAX;
+out:
+	crypto_hash_free_ctx(ctx);
+
+	return res;
+}
+
 static TEE_Result cmd_get_cbor_evidence(uint32_t param_types,
 					TEE_Param params[TEE_NUM_PARAMS])
 {
@@ -124,7 +163,7 @@ static TEE_Result cmd_get_cbor_evidence(uint32_t param_types,
 	TEE_Result status = TEE_SUCCESS;
 
 	const char eat_profile[] = EAT_PROFILE;
-	const int psa_client_id = CLIENT_ID;
+	int psa_client_id = 0;
 	int psa_security_lifecycle = LIFECYCLE;
 	const char measurement_type[] = MEASURMENT_TYPE;
 	uint8_t signer_id[SIGNER_ID_LEN] = { };
@@ -153,6 +192,10 @@ static TEE_Result cmd_get_cbor_evidence(uint32_t param_types,
 	if (!s || !is_user_ta_ctx(s->ctx))
 		return TEE_ERROR_ACCESS_DENIED;
 
+	status = get_client_id(&s->ctx->uuid, &psa_client_id);
+	if (status != TEE_SUCCESS)
+		return status;
+
 	status = key_get(&skey);
 	if (status != TEE_SUCCESS)
 		return status;
-- 
