From 6e063315e42139de7fb8a91291d4fa229a16b554 Mon Sep 17 00:00:00 2001
From: Yuichi Sugiyama <yuichis@ricsec.co.jp>
Date: Mon, 12 Oct 2026 12:26:28 +0000
Subject: [PATCH] pta: veraison_attestation: wrap an imported key in the
 CAAM

A key generated by the PTA is a CAAM black key when the CAAM ECC
driver is enabled, but a key installed with IMPORT_KEY was stored as
the plain scalar it came as.

Wrap it before storing it, through a new caam_key_wrap_black() in the
CAAM extension API, the interface the other i.MX PTAs use, so that the
PTA needs none of the driver's internal headers: the CAAM turns the
scalar into a black key and the serialized form, a blob bound to the
device, is what gets stored. The plain copy the wrapping works on is
cleared on every exit path, including the ones where the CAAM never
got to it.

Upstream-Status: Submitted [https://github.com/OP-TEE/optee_os/pull/8109]
Signed-off-by: Yuichi Sugiyama <yuichis@ricsec.co.jp>
---
 core/drivers/crypto/caam/caam_key.c   | 52 +++++++++++++++++++++++++++
 core/include/drivers/caam_extension.h | 14 ++++++++
 core/pta/veraison_attestation/key.c   | 13 +++++++
 3 files changed, 79 insertions(+)

diff --git a/core/drivers/crypto/caam/caam_key.c b/core/drivers/crypto/caam/caam_key.c
index 9c5d0ee..83de5d4 100644
--- a/core/drivers/crypto/caam/caam_key.c
+++ b/core/drivers/crypto/caam/caam_key.c
@@ -8,7 +8,9 @@
 #include <caam_status.h>
 #include <caam_trace.h>
 #include <caam_utils_mem.h>
+#include <caam_utils_status.h>
 #include <crypto/crypto.h>
+#include <drivers/caam_extension.h>
 #include <kernel/panic.h>
 #include <mm/core_memprot.h>
 #include <stdint.h>
@@ -758,6 +760,56 @@ out:
 	return status;
 }
 
+TEE_Result caam_key_wrap_black(const uint8_t *key, size_t key_size,
+			       uint8_t *out, size_t *out_size)
+{
+	enum caam_status status = CAAM_FAILURE;
+	struct caamkey ckey = {
+		.key_type = CAAM_KEY_PLAIN_TEXT,
+		.sec_size = key_size,
+		.is_blob = false,
+	};
+	size_t size = 0;
+
+	if (!key || !key_size || !out_size)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	status = caam_key_alloc(&ckey);
+	if (status)
+		return caam_status_to_tee_result(status);
+
+	memcpy(ckey.buf.data, key, key_size);
+
+	status = caam_key_black_encapsulation(&ckey,
+					      caam_key_default_key_gen_type());
+	if (status)
+		goto out;
+
+	status = caam_key_serialized_size(&ckey, &size);
+	if (status)
+		goto out;
+
+	if (!out || *out_size < size) {
+		*out_size = size;
+		status = CAAM_SHORT_BUFFER;
+		goto out;
+	}
+
+	status = caam_key_serialize_to_bin(out, *out_size, &ckey);
+	if (!status)
+		*out_size = size;
+out:
+	/*
+	 * Whatever the key buffer holds by now, the plain key if the
+	 * encapsulation did not get to it, must not outlive the call
+	 */
+	if (ckey.buf.data)
+		memzero_explicit(ckey.buf.data, ckey.buf.length);
+	caam_key_free(&ckey);
+
+	return caam_status_to_tee_result(status);
+}
+
 enum caam_status caam_key_init(void)
 {
 	size_t alloc_size = 0;
diff --git a/core/include/drivers/caam_extension.h b/core/include/drivers/caam_extension.h
index 41ccec0..52c864b 100644
--- a/core/include/drivers/caam_extension.h
+++ b/core/include/drivers/caam_extension.h
@@ -52,4 +52,18 @@ TEE_Result caam_mp_sign(uint8_t *data, size_t *data_size, uint8_t *sig,
 TEE_Result caam_dek_generate(const uint8_t *payload, size_t payload_size,
 			     uint8_t *dek, size_t dek_size);
 #endif /* CFG_NXP_CAAM_DEK_DRV */
+
+/*
+ * Wrap a plain key into a serialized CAAM black key: a CAAM black key in
+ * a CAAM blob, the form the CAAM crypto driver accepts as the private key
+ * of an asymmetric key. The CAAM does the wrapping; the caller is expected
+ * to discard the plain key afterwards.
+ *
+ * @key        Plain key
+ * @key_size   Size of @key in bytes
+ * @out        Output buffer, may be NULL to query the size
+ * @out_size   [in/out] Size of @out, set to the serialized key size
+ */
+TEE_Result caam_key_wrap_black(const uint8_t *key, size_t key_size,
+			       uint8_t *out, size_t *out_size);
 #endif /* __DRIVERS_CAAM_EXTENSION_H__ */
diff --git a/core/pta/veraison_attestation/key.c b/core/pta/veraison_attestation/key.c
index 35b677b..a6b5b20 100644
--- a/core/pta/veraison_attestation/key.c
+++ b/core/pta/veraison_attestation/key.c
@@ -16,6 +16,10 @@
 #include <trace.h>
 #include <utee_defines.h>
 
+#ifdef CFG_NXP_CAAM_ECC_DRV
+#include <drivers/caam_extension.h>
+#endif
+
 #include "key.h"
 #include "sign.h"
 
@@ -311,8 +315,17 @@ TEE_Result key_import(const uint8_t *pub_x, const uint8_t *pub_y,
 
 	memcpy(new_key.pub_x, pub_x, KEY_SIZE);
 	memcpy(new_key.pub_y, pub_y, KEY_SIZE);
+#ifdef CFG_NXP_CAAM_ECC_DRV
+	/* Keep it as a CAAM black key, like a generated key */
+	new_key.priv_len = sizeof(new_key.priv);
+	res = caam_key_wrap_black(priv, KEY_SIZE, new_key.priv,
+				  &new_key.priv_len);
+	if (res)
+		goto out;
+#else
 	memcpy(new_key.priv, priv, KEY_SIZE);
 	new_key.priv_len = KEY_SIZE;
+#endif
 
 	/* Only a matching pair signs and verifies */
 	res = sign_ecdsa_sha256(&new_key, check_msg, sizeof(check_msg), sig,
-- 
